<%- include('../partials/head') %>
<section class="auth-card">
  <div class="brand auth-brand"><span class="mark" aria-hidden="true">CE</span>Course Enrollment</div>
  <h1><%= title %></h1>
  <% if (registered) { %><p class="notice" role="status">Account created. Sign in to continue.</p><% } %>
  <% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
  <form method="post" action="/<%= mode %>" class="stack">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <% if (mode === 'register') { %>
      <label>Full name<input name="name" value="<%= values.name || '' %>" required maxlength="100" autocomplete="name"></label>
    <% } %>
    <label>Email<input type="email" name="email" value="<%= values.email || '' %>" required maxlength="254" autocomplete="email"></label>
    <label>Password<input type="password" name="password" required <%= mode === 'register' ? 'minlength=12 maxlength=72' : '' %>
      autocomplete="<%= mode === 'register' ? 'new-password' : 'current-password' %>" <%= mode === 'register' ? 'aria-describedby=password-rule' : '' %>></label>
    <% if (mode === 'register') { %><small id="password-rule">Use at least 12 characters.</small><% } %>
    <button class="button primary"><%= title %></button>
  </form>
  <% if (mode === 'login') { %>
    <p class="auth-switch">Need a staff account? <a href="/register">Register</a></p>
  <% } else { %>
    <p class="auth-switch">Already registered? <a href="/login">Sign in</a></p>
  <% } %>
</section>
<%- include('../partials/foot') %>
