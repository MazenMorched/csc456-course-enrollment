<%- include('../partials/head') %>
<header class="page-heading">
  <h1><%= title %></h1>
  <% if (currentUser.role === 'admin') { %><a class="button primary" href="<%= base %>/new">New <%= resource.singular %></a><% } %>
</header>
<% if (records.length === 0) { %>
  <p class="panel empty">No <%= resource.plural.toLowerCase() %> yet.</p>
<% } else { %>
  <div class="panel table-wrap">
    <table>
      <thead><tr>
        <% for (const field of resource.fields.filter(field => field.type !== 'textarea')) { %>
          <th scope="col"><%= field.label %></th>
        <% } %>
      </tr></thead>
      <tbody>
      <% for (const record of records) { %>
        <tr>
          <% for (const field of resource.fields.filter(field => field.type !== 'textarea')) { %>
            <td>
              <% if (field.key === resource.label) { %>
                <a href="<%= base %>/<%= record._id %>"><%= record[field.key] %></a>
              <% } else { %>
                <%= field.type === 'select' ? record[field.key]?.name || 'Unavailable' : record[field.key] %>
              <% } %>
            </td>
          <% } %>
        </tr>
      <% } %>
      </tbody>
    </table>
  </div>
<% } %>
<%- include('../partials/foot') %>
